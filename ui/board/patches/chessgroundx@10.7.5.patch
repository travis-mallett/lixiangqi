@@ -0,0 +1,21 @@
+import type { State } from './state.js';
+import type { AnimPlan } from './anim.js';
+
+/** The embedding board owns presentation. Chessground supplies lifecycle hooks only. */
+export interface PieceMotion {
+  sync(state: State): void;
+  shadows(state: State): void;
+  shadow(root: HTMLElement): void;
+  reset(state: State): void;
+  prepare(state: State): void;
+  animate(state: State, plan: AnimPlan, mode: 'move' | 'slide' | 'reveal'): void;
+}
+export function usesLayeredPieces(state: Pick<State, 'layeredPieces'>): boolean { return state.layeredPieces; }
+export function syncXiangqiMotion(state: State): void { state.pieceMotion?.sync(state); }
+export function syncXiangqiShadows(state: State): void { state.pieceMotion?.shadows(state); }
+export function syncXiangqiShadowPosition(state: State, root: HTMLElement): void { state.pieceMotion?.shadow(root); }
+export function resetXiangqiMotion(state: State): void { state.pieceMotion?.reset(state); }
+export function prepareXiangqiMutation(state: State): void { state.pieceMotion?.prepare(state); }
+export function animateXiangqi(state: State, plan: AnimPlan): void { state.pieceMotion!.animate(state, plan, 'move'); }
+export function animateXiangqiSlide(state: State, plan: AnimPlan): void { state.pieceMotion!.animate(state, plan, 'slide'); }
+export function animateJieqiReveal(state: State, plan: AnimPlan): void { state.pieceMotion!.animate(state, plan, 'reveal'); }
