new file mode 100644
index 0000000000000000000000000000000000000000..bfe89728c0ed630ae3866c0a5de25385627e1661
--- /dev/null
+++ b/src/xiangqiLastMove.ts
@@ -0,0 +1,43 @@
+import type { State } from './state.js';
+import { key2pos, isKey } from './util.js';
+
+// Geometry is independent of the board artwork. Themes opt into the connector
+// through CSS, so changing a theme does not require rebuilding the board.
+export function syncLastMoveConnector(state: State): void {
+  const board = state.dom.elements.board;
+  let svg = board.querySelector<SVGSVGElement>('.xiangqi-last-move-connector');
+  const move = state.highlight.lastMove ? state.lastMove : undefined;
+  const orig = move?.[0];
+  const dest = move?.[1];
+  if (!orig || !dest || !isKey(orig) || !isKey(dest) || orig === 'a0' || dest === 'a0' || orig === dest) {
+    svg?.remove();
+    return;
+  }
+  const signature = `${orig}${dest}/${state.orientation}`;
+  if (svg?.dataset.move === signature) return;
+  if (!svg) {
+    svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    svg.classList.add('xiangqi-last-move-connector');
+    svg.setAttribute('viewBox', `0 0 ${state.dimensions.width} ${state.dimensions.height}`);
+    svg.setAttribute('aria-hidden', 'true');
+    svg.append(document.createElementNS(svg.namespaceURI, 'line'));
+    board.prepend(svg);
+  }
+  svg.dataset.move = signature;
+  const point = (key: typeof orig): number[] => {
+    const [x, y] = key2pos(key);
+    return state.orientation === 'white' ? [x + 0.5, state.dimensions.height - 0.5 - y] : [state.dimensions.width - 0.5 - x, y + 0.5];
+  };
+  const [x1, y1] = point(orig);
+  const [x2, y2] = point(dest);
+  const distance = Math.hypot(x2 - x1, y2 - y1);
+  const dx = (x2 - x1) / distance;
+  const dy = (y2 - y1) / distance;
+  const line = svg.firstElementChild!;
+  // Leave room for the origin marker and destination piece, including on
+  // diagonal moves. Board-space units keep the gaps proportional on resize.
+  line.setAttribute('x1', String(x1 + dx * 0.4));
+  line.setAttribute('y1', String(y1 + dy * 0.4));
+  line.setAttribute('x2', String(x2 - dx * 0.5));
+  line.setAttribute('y2', String(y2 - dy * 0.5));
+}
diff --git a/src/xiangqiMotion.ts b/src/xiangqiMotion.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f9e65c0f165ca2a4cb12814bc9f72c7dd2ee9c69
--- /dev/null
+++ b/src/xiangqiMotion.ts
@@ -0,0 +1,831 @@
+import type { AnimPlan, AnimVector } from './anim.js';
+import { whitePov } from './board.js';
+import type { State } from './state.js';
+import * as cg from './types.js';
+import { key2pos, pos2key, posToTranslate } from './util.js';
+
+const LIFT_MS = 33;
+const CARRY_MS = 150;
+const LAND_MS = 150;
+const SLIDE_BASE_MS = 83.333;
+const SLIDE_PER_CELL_MS = 16.667;
+const SLIDE_MAX_MS = 180;
+const CAMERA_DISTANCE_PIECES = 3;
+
+const depthColorCache = new Map<string, Promise<string>>();
+const runtimes = new WeakMap<State, MotionRuntime>();
+const contactShadows = new WeakMap<HTMLElement, HTMLElement>();
+const shadowPieces = new WeakMap<Element, HTMLElement>();
+const shadowLayers = new WeakMap<HTMLElement, HTMLElement>();
+
+// Contact shadows belong to the board plane, outside each transformed piece's
+// stacking context. Keep one companion per DOM piece, including fading pieces.
+function contactShadowFor(root: HTMLElement): HTMLElement {
+  let shadow = contactShadows.get(root);
+  if (!shadow) {
+    shadow = span('xiangqi-piece-shadow');
+    shadow.append(span('xiangqi-motion-shadow-contact'));
+    shadow.setAttribute('aria-hidden', 'true');
+    contactShadows.set(root, shadow);
+    shadowPieces.set(shadow, root);
+  }
+  const board = root.parentElement;
+  if (board) {
+    let layer = shadowLayers.get(board);
+    if (!layer) {
+      layer = span('xiangqi-shadow-layer');
+      layer.setAttribute('aria-hidden', 'true');
+      shadowLayers.set(board, layer);
+      board.append(layer);
+    }
+    if (shadow.parentElement !== layer) layer.append(shadow);
+  }
+  syncXiangqiShadowPosition(root);
+  return shadow;
+}
+
+export function syncXiangqiShadowPosition(root: HTMLElement): void {
+  const shadow = contactShadows.get(root);
+  if (!shadow) return;
+  shadow.style.transform = root.style.transform;
+  shadow.style.visibility = root.style.visibility;
+  shadow.style.opacity = root.style.opacity;
+  shadow.classList.toggle('fading', root.classList.contains('fading'));
+  shadow.classList.toggle(
+    'xiangqi-last-move-destination',
+    root.classList.contains('xiangqi-last-move-destination'),
+  );
+  shadow.dataset.key = (root as cg.PieceNode).cgKey;
+}
+
+export function syncXiangqiShadows(state: State): void {
+  if (!usesLayeredPieces(state)) return;
+  const board = state.dom.elements.board;
+  for (const child of Array.from(board.children)) {
+    if (child.tagName === 'PIECE') contactShadowFor(child as HTMLElement);
+  }
+  const layer = shadowLayers.get(board);
+  if (layer)
+    for (const child of Array.from(layer.children))
+      if (shadowPieces.get(child)?.parentElement !== board) child.remove();
+}
+
+interface MotionLayers {
+  contactShadow: HTMLElement;
+  airborneShadow: HTMLElement;
+  stack: HTMLElement;
+  rim: HTMLElement;
+}
+
+interface ActivePiece {
+  root: cg.PieceNode;
+  key: cg.Key;
+  cameraDistance: number;
+  layers: MotionLayers;
+  animations: Set<Animation>;
+  generation: number;
+}
+
+interface PlannedMove {
+  active: ActivePiece;
+  dest: cg.Key;
+  from: cg.NumberPair;
+  to: cg.NumberPair;
+  fromRest: boolean;
+}
+
+interface MotionRuntime {
+  active: Set<ActivePiece>;
+  animations: Set<Animation>;
+  epoch: number;
+  moving: boolean;
+  selected?: ActivePiece;
+}
+
+export function usesLayeredPieces(state: Pick<State, 'layeredPieces'>): boolean {
+  return state.layeredPieces;
+}
+
+export function prepareXiangqiMutation(state: State): void {
+  const runtime = runtimes.get(state);
+  if (
+    !runtime ||
+    (!runtime.moving && (!runtime.active.size || (runtime.selected && state.selectable.selected)))
+  )
+    return;
+  resetXiangqiMotion(state);
+  state.dom.redrawNow(true);
+}
+
+export function animateXiangqi(state: State, plan: AnimPlan): void {
+  const runtime = runtimeFor(state);
+  const bounds = state.dom.bounds();
+  const translate = posToTranslate(bounds, state.dimensions);
+  const asWhite = whitePov(state);
+  const moves: PlannedMove[] = [];
+  const retainedSelection = runtime.selected;
+
+  runtime.epoch += 1;
+  runtime.moving = true;
+
+  for (const [dest, vector] of plan.anims) {
+    const destPos = key2pos(dest);
+    const orig = pos2key([destPos[0] + vector[0], destPos[1] + vector[1]]);
+    const selected = retainedSelection?.key === orig ? retainedSelection : undefined;
+    const source = selected?.root ?? pieceElementByKey(state, orig);
+    if (!source) continue;
+
+    const active = selected ?? activatePiece(state, source, orig);
+    const from = translate(key2pos(orig), asWhite);
+    const to = translate(destPos, asWhite);
+    active.key = dest;
+    moves.push({ active, dest, from, to, fromRest: !selected });
+  }
+
+  if (retainedSelection && !moves.some(move => move.active === retainedSelection)) {
+    cleanupActive(runtime, retainedSelection);
+  }
+  runtime.selected = undefined;
+
+  state.animation.current = {
+    start: performance.now(),
+    frequency: 1 / phaseDuration(state, CARRY_MS + LAND_MS),
+    plan,
+  };
+  state.dom.redrawNow(true);
+
+  if (!moves.length) {
+    finishMove(state, runtime, runtime.epoch, moves);
+    return;
+  }
+
+  const epoch = runtime.epoch;
+  void runMove(state, runtime, epoch, moves, plan);
+}
+
+export function animateXiangqiSlide(state: State, plan: AnimPlan): void {
+  const runtime = runtimeFor(state);
+  const bounds = state.dom.bounds();
+  const translate = posToTranslate(bounds, state.dimensions);
+  const asWhite = whitePov(state);
+  const slides: Array<{ root: cg.PieceNode; from: cg.NumberPair; to: cg.NumberPair; duration: number }> = [];
+
+  runtime.epoch += 1;
+  runtime.moving = true;
+
+  for (const [dest, vector] of plan.anims) {
+    const destPos = key2pos(dest);
+    const origPos: cg.Pos = [destPos[0] + vector[0], destPos[1] + vector[1]];
+    const root = pieceElementByKey(state, pos2key(origPos));
+    if (!root) continue;
+    const distance = Math.hypot(vector[0], vector[1]);
+    slides.push({
+      root,
+      from: translate(origPos, asWhite),
+      to: translate(destPos, asWhite),
+      duration: phaseDuration(state, Math.min(SLIDE_MAX_MS, SLIDE_BASE_MS + SLIDE_PER_CELL_MS * distance)),
+    });
+  }
+
+  const duration = Math.max(1, ...slides.map(slide => slide.duration));
+  state.animation.current = {
+    start: performance.now(),
+    frequency: 1 / duration,
+    plan,
+  };
+  state.dom.redrawNow(true);
+
+  const epoch = runtime.epoch;
+  if (!slides.length) {
+    finishSlide(state, runtime, epoch);
+    return;
+  }
+
+  void Promise.all(
+    slides.map(({ root, from, to, duration }) => {
+      return animateTravel(state, runtime, undefined, root, from, to, slideSteps, duration);
+    }),
+  ).then(() => finishSlide(state, runtime, epoch));
+}
+
+export function syncXiangqiMotion(state: State): void {
+  if (!usesLayeredPieces(state)) return;
+  prewarmDepthColors(state);
+  syncLastMovePresentation(state);
+  syncXiangqiShadows(state);
+
+  const runtime = runtimeFor(state);
+  if (runtime.moving) return;
+  // Chessground owns the piece while a pointer drag is in progress. This also
+  // lets click-or-drag distinguish a released click (lift it) from a drag
+  // (use Chessground's standard presentation).
+  if (!motionEnabled(state) || state.draggable.current) {
+    resetXiangqiMotion(state);
+    return;
+  }
+
+  const selected = state.selectable.selected;
+  const selectedKey = typeof selected === 'string' && selected !== 'a0' ? selected : undefined;
+  if (!selectedKey) {
+    if (runtime.selected) {
+      const active = runtime.selected;
+      runtime.selected = undefined;
+      void landSelected(state, runtime, active);
+    }
+    return;
+  }
+
+  const root = pieceElementByKey(state, selectedKey);
+  if (!root) return;
+  if (runtime.selected?.root === root) return;
+
+  if (runtime.selected) {
+    const previous = runtime.selected;
+    runtime.selected = undefined;
+    void landSelected(state, runtime, previous);
+  }
+
+  const active = activatePiece(state, root, selectedKey);
+  runtime.selected = active;
+  lift(state, active);
+}
+
+export function resetXiangqiMotion(state: State): void {
+  const runtime = runtimes.get(state);
+  if (!runtime) return;
+
+  runtime.epoch += 1;
+  cancelAnimations(runtime.animations);
+  for (const active of [...runtime.active]) cleanupActive(runtime, active);
+  runtime.selected = undefined;
+  runtime.moving = false;
+  state.animation.current = undefined;
+  runtimes.delete(state);
+}
+
+async function runMove(
+  state: State,
+  runtime: MotionRuntime,
+  epoch: number,
+  moves: PlannedMove[],
+  plan: AnimPlan,
+): Promise<void> {
+  const duration = phaseDuration(state, CARRY_MS);
+  const carryAnimations: Promise<void>[] = [];
+
+  for (const move of moves) {
+    const { active, from, to, fromRest } = move;
+    const dx = to[0] - from[0];
+    const dy = to[1] - from[1];
+    const { stack, contactShadow, airborneShadow, rim } = active.layers;
+
+    carryAnimations.push(
+      animateTravel(state, runtime, active, active.root, from, to, carrySteps, duration),
+      animate(
+        runtime,
+        active,
+        stack,
+        fromRest
+          ? [
+              { transform: idleTransform(active), offset: 0 },
+              { transform: heldTransform(active), offset: 0.2 },
+              { transform: peakTransform(active), offset: 1 },
+            ]
+          : [
+              { transform: heldTransform(active), offset: 0 },
+              { transform: heldTransform(active), offset: 0.2 },
+              { transform: peakTransform(active), offset: 1 },
+            ],
+        duration,
+      ),
+      animate(
+        runtime,
+        active,
+        contactShadow,
+        fromRest
+          ? [
+              { opacity: 1, offset: 0 },
+              { opacity: 0, offset: 0.2 },
+              { opacity: 0, offset: 1 },
+            ]
+          : [{ opacity: 0 }, { opacity: 0 }],
+        duration,
+      ),
+      animate(
+        runtime,
+        active,
+        airborneShadow,
+        fromRest
+          ? [
+              { transform: 'translate3d(0,0,0)', opacity: 0, offset: 0 },
+              { transform: 'translate3d(0,0,0)', opacity: 1, offset: 0.2 },
+              { transform: 'translate3d(2.4%,3.4%,0) scale(1.07)', opacity: 0.8, offset: 1 },
+            ]
+          : [
+              { transform: 'translate3d(0,0,0)', opacity: 1, offset: 0 },
+              { transform: 'translate3d(2.4%,3.4%,0) scale(1.07)', opacity: 0.8, offset: 1 },
+            ],
+        duration,
+      ),
+      animate(
+        runtime,
+        active,
+        rim,
+        fromRest
+          ? [
+              { opacity: 0, offset: 0 },
+              { opacity: 0.96, offset: 0.2 },
+              { opacity: 0.96, offset: 1 },
+            ]
+          : [{ opacity: 0.96 }, { opacity: 0.96 }],
+        duration,
+      ),
+    );
+
+    const destination = squareElementByKey(state, move.dest, 'last-move-destination');
+    if (destination) {
+      destination.classList.add('xiangqi-motion-underlay');
+      carryAnimations.push(
+        animate(runtime, undefined, destination, rootCarryKeyframes(from, dx, dy), duration),
+      );
+    }
+  }
+
+  const bounds = state.dom.bounds();
+  const translate = posToTranslate(bounds, state.dimensions);
+  const asWhite = whitePov(state);
+  for (const [key] of plan.fadings) {
+    const captured = fadingPieceElementByKey(state, key);
+    if (!captured) continue;
+    const position = translate(key2pos(key), asWhite);
+    carryAnimations.push(
+      animate(
+        runtime,
+        undefined,
+        captured,
+        [
+          { opacity: 1, transform: `${translated(position, 0, 0, 0)} scale(1)` },
+          { opacity: 0.72, transform: `${translated(position, 0, 0, 0)} scale(.96)`, offset: 0.62 },
+          { opacity: 0, transform: `${translated(position, 0, 0, 0)} scale(.86)`, offset: 1 },
+        ],
+        duration,
+        'ease-in',
+      ),
+    );
+  }
+
+  await Promise.all(carryAnimations);
+  if (runtime.epoch !== epoch || !runtime.moving) return;
+
+  await Promise.all(moves.map(move => land(state, runtime, move.active, true)));
+  if (runtime.epoch !== epoch || !runtime.moving) return;
+  finishMove(state, runtime, epoch, moves);
+}
+
+function lift(state: State, active: ActivePiece): void {
+  const generation = ++active.generation;
+  const duration = phaseDuration(state, LIFT_MS);
+  const { stack, contactShadow, airborneShadow, rim } = active.layers;
+
+  void Promise.all([
+    animate(
+      runtimeFor(state),
+      active,
+      stack,
+      [{ transform: idleTransform(active) }, { transform: heldTransform(active) }],
+      duration,
+    ),
+    animate(runtimeFor(state), active, contactShadow, [{ opacity: 1 }, { opacity: 0 }], duration),
+    animate(runtimeFor(state), active, airborneShadow, [{ opacity: 0 }, { opacity: 1 }], duration),
+    animate(runtimeFor(state), active, rim, [{ opacity: 0 }, { opacity: 0.96 }], duration),
+  ]).then(() => {
+    if (active.generation === generation) active.root.classList.add('xiangqi-motion-held');
+  });
+}
+
+async function landSelected(state: State, runtime: MotionRuntime, active: ActivePiece): Promise<void> {
+  const generation = ++active.generation;
+  await land(state, runtime, active, false);
+  if (active.generation === generation && runtime.selected !== active && !runtime.moving) {
+    cleanupActive(runtime, active);
+  }
+}
+
+function land(state: State, runtime: MotionRuntime, active: ActivePiece, fromPeak: boolean): Promise<void> {
+  const duration = phaseDuration(state, LAND_MS);
+  const airborneStartOpacity = fromPeak ? 0.8 : 1;
+  const { stack, contactShadow, airborneShadow, rim } = active.layers;
+
+  return Promise.all([
+    animate(
+      runtime,
+      active,
+      stack,
+      [
+        { transform: fromPeak ? peakTransform(active) : heldTransform(active), offset: 0 },
+        { transform: projectedPose(active, -7.5, 23, 1.25), offset: 0.2 },
+        { transform: projectedPose(active, -5, 17, 1.18), offset: 0.4 },
+        { transform: projectedPose(active, -2.8, 10, 1.11), offset: 0.6 },
+        { transform: projectedPose(active, -0.8, 3, 1.04), offset: 0.8 },
+        { transform: idleTransform(active), offset: 1 },
+      ],
+      duration,
+    ),
+    animate(
+      runtime,
+      active,
+      airborneShadow,
+      [
+        {
+          transform: fromPeak ? 'translate3d(2.4%,3.4%,0) scale(1.07)' : 'translate3d(0,0,0)',
+          opacity: airborneStartOpacity,
+        },
+        { transform: 'translate3d(0,0,0)', opacity: 0 },
+      ],
+      duration,
+    ),
+    animate(runtime, active, contactShadow, [{ opacity: 0 }, { opacity: 1 }], duration),
+    animate(
+      runtime,
+      active,
+      rim,
+      [
+        { opacity: 0.96, offset: 0 },
+        { opacity: 0.82, offset: 0.2 },
+        { opacity: 0.58, offset: 0.4 },
+        { opacity: 0.32, offset: 0.6 },
+        { opacity: 0.1, offset: 0.8 },
+        { opacity: 0, offset: 1 },
+      ],
+      duration,
+    ),
+  ]).then(() => undefined);
+}
+
+function finishMove(state: State, runtime: MotionRuntime, epoch: number, moves: PlannedMove[]): void {
+  if (runtime.epoch !== epoch) return;
+  runtime.moving = false;
+  state.animation.current = undefined;
+  cancelAnimations(runtime.animations);
+  for (const move of moves) cleanupActive(runtime, move.active);
+  state.dom.redrawNow();
+}
+
+function finishSlide(state: State, runtime: MotionRuntime, epoch: number): void {
+  if (runtime.epoch !== epoch) return;
+  runtime.moving = false;
+  state.animation.current = undefined;
+  cancelAnimations(runtime.animations);
+  state.dom.redrawNow();
+}
+
+function activatePiece(state: State, root: cg.PieceNode, key: cg.Key): ActivePiece {
+  const runtime = runtimeFor(state);
+  const existing = [...runtime.active].find(active => active.root === root);
+  if (existing) return existing;
+
+  const backgroundImage = computedBackgroundImage(root);
+  clearLastMovePresentation(root);
+  const contactShadow = contactShadowFor(root).firstElementChild as HTMLElement;
+  const airborneShadow = span('xiangqi-motion-shadow-airborne');
+  const camera = span('xiangqi-motion-camera');
+  const stack = span('xiangqi-motion-stack');
+  const rim = span('xiangqi-motion-rim');
+  const face = span('xiangqi-motion-face');
+  const cameraDistance = (state.dom.bounds().width / state.dimensions.width) * CAMERA_DISTANCE_PIECES;
+
+  face.style.backgroundImage = backgroundImage;
+  stack.append(rim, face);
+  camera.append(stack);
+  root.append(airborneShadow, camera);
+  root.style.setProperty('--xiangqi-piece-perspective', `${cameraDistance}px`);
+  root.classList.add('xiangqi-motion-piece');
+
+  const active: ActivePiece = {
+    root,
+    key,
+    cameraDistance,
+    layers: { contactShadow, airborneShadow, stack, rim },
+    animations: new Set(),
+    generation: 0,
+  };
+  runtime.active.add(active);
+
+  void depthColor(backgroundImage, root).then(color => {
+    if (root.isConnected && runtime.active.has(active)) {
+      root.style.setProperty('--xiangqi-piece-depth-color', color);
+    }
+  });
+  return active;
+}
+
+function cleanupActive(runtime: MotionRuntime, active: ActivePiece): void {
+  if (!runtime.active.delete(active)) return;
+  active.generation += 1;
+  cancelAnimations(active.animations);
+  active.root.classList.remove('xiangqi-motion-piece', 'xiangqi-motion-held');
+  active.root.style.removeProperty('--xiangqi-piece-perspective');
+  active.root.style.removeProperty('--xiangqi-piece-depth-color');
+  active.layers.airborneShadow.remove();
+  active.layers.stack.parentElement?.remove();
+}
+
+function runtimeFor(state: State): MotionRuntime {
+  let runtime = runtimes.get(state);
+  if (!runtime) {
+    runtime = { active: new Set(), animations: new Set(), epoch: 0, moving: false };
+    runtimes.set(state, runtime);
+  }
+  return runtime;
+}
+
+function motionEnabled(state: State): boolean {
+  return state.animation.enabled && !prefersReducedMotion();
+}
+
+function prefersReducedMotion(): boolean {
+  return typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
+}
+
+function phaseDuration(state: State, duration: number): number {
+  if (!motionEnabled(state)) return 1;
+  const preferenceScale = state.animation.duration <= 120 ? 0.5 : state.animation.duration >= 500 ? 1.5 : 1;
+  return duration * preferenceScale;
+}
+
+function animate(
+  runtime: MotionRuntime,
+  active: ActivePiece | undefined,
+  element: HTMLElement | SVGSVGElement,
+  keyframes: Keyframe[],
+  duration: number,
+  easing = 'linear',
+): Promise<void> {
+  const shadow = element.tagName === 'PIECE' ? contactShadows.get(element as HTMLElement) : undefined;
+  if (shadow) {
+    // Mirror board-space travel/fading, while contact opacity remains an
+    // independent animation on its child. Both cancel with the same owner.
+    void animate(runtime, active, shadow, keyframes, duration, easing);
+  }
+  const animation = element.animate(keyframes, { duration, easing, fill: 'forwards' });
+  runtime.animations.add(animation);
+  active?.animations.add(animation);
+  return animation.finished.then(() => undefined).catch(() => undefined);
+}
+
+function cancelAnimations(animations: Set<Animation>): void {
+  for (const animation of animations) animation.cancel();
+  animations.clear();
+}
+
+function projectedPose(
+  active: ActivePiece,
+  translateY: number,
+  pitch: number,
+  apparentScale: number,
+): string {
+  const depth = active.cameraDistance * (1 - 1 / apparentScale);
+  return `translate3d(0, ${translateY}%, ${depth.toFixed(3)}px) rotateX(${pitch}deg)`;
+}
+
+function idleTransform(active: ActivePiece): string {
+  return projectedPose(active, 0, 0, 1);
+}
+
+function heldTransform(active: ActivePiece): string {
+  return projectedPose(active, -7, 27, 1.18);
+}
+
+function peakTransform(active: ActivePiece): string {
+  return projectedPose(active, -10, 27, 1.3);
+}
+
+function translated(origin: cg.NumberPair, dx: number, dy: number, progress: number): string {
+  return `translate3d(${origin[0] + dx * progress}px,${origin[1] + dy * progress}px,0)`;
+}
+
+function rootCarryKeyframes(origin: cg.NumberPair, dx: number, dy: number): Keyframe[] {
+  return carrySteps.map(({ progress, offset }) => ({
+    transform: translated(origin, dx, dy, progress),
+    offset,
+  }));
+}
+
+function syncLastMovePresentation(state: State): void {
+  let destination: cg.Orig | undefined;
+  if (state.highlight.lastMove && state.lastMove) {
+    for (let index = state.lastMove.length - 1; index >= 0; index--) {
+      const key = state.lastMove[index];
+      if (typeof key === 'string' && key !== 'a0') {
+        destination = key;
+        break;
+      }
+    }
+  }
+  let element = state.dom.elements.board.firstElementChild;
+  while (element) {
+    if (element.tagName === 'PIECE') {
+      const root = element as cg.PieceNode;
+      root.classList.toggle('xiangqi-last-move-destination', root.cgKey === destination);
+      if (root.cgKey === destination && !root.classList.contains('xiangqi-motion-piece')) {
+        ensureLastMovePresentation(root);
+      } else clearLastMovePresentation(root);
+    }
+    element = element.nextElementSibling;
+  }
+}
+
+function ensureLastMovePresentation(root: cg.PieceNode): void {
+  if (root.classList.contains('xiangqi-last-move-piece')) return;
+  const highlight = span('xiangqi-last-move-highlight');
+  root.append(highlight);
+  root.classList.add('xiangqi-last-move-piece');
+}
+
+function clearLastMovePresentation(root: cg.PieceNode): void {
+  if (!root.classList.contains('xiangqi-last-move-piece')) return;
+  root.classList.remove('xiangqi-last-move-piece');
+  for (const child of [...root.children]) {
+    if (child.classList.contains('xiangqi-last-move-highlight')) child.remove();
+  }
+}
+
+function span(className: string): HTMLElement {
+  const element = document.createElement('span');
+  element.className = className;
+  return element;
+}
+
+function pieceElementByKey(state: State, key: cg.Key): cg.PieceNode | undefined {
+  let element = state.dom.elements.board.firstElementChild;
+  while (element) {
+    const keyed = element as cg.KeyedNode;
+    if (keyed.tagName === 'PIECE' && keyed.cgKey === key) return keyed as cg.PieceNode;
+    element = element.nextElementSibling;
+  }
+  return;
+}
+
+function fadingPieceElementByKey(state: State, key: cg.Key): cg.PieceNode | undefined {
+  let element = state.dom.elements.board.firstElementChild;
+  while (element) {
+    const piece = element as cg.PieceNode;
+    if (piece.tagName === 'PIECE' && piece.cgKey === key && piece.cgFading) return piece;
+    element = element.nextElementSibling;
+  }
+  return;
+}
+
+function squareElementByKey(state: State, key: cg.Key, className: string): cg.SquareNode | undefined {
+  let element = state.dom.elements.board.firstElementChild;
+  while (element) {
+    const square = element as cg.SquareNode;
+    if (square.tagName === 'SQUARE' && square.cgKey === key && square.classList.contains(className))
+      return square;
+    element = element.nextElementSibling;
+  }
+  return;
+}
+
+function prewarmDepthColors(state: State): void {
+  for (const element of Array.from(state.dom.elements.board.children)) {
+    if (element.tagName !== 'PIECE' || element.classList.contains('xiangqi-motion-piece')) continue;
+    const piece = element as cg.PieceNode;
+    const backgroundImage = computedBackgroundImage(piece);
+    if (backgroundUrl(backgroundImage)) void depthColor(backgroundImage, piece);
+  }
+}
+
+function depthColor(backgroundImage: string, piece: HTMLElement): Promise<string> {
+  const url = backgroundUrl(backgroundImage);
+  if (!url) return Promise.resolve(fallbackDepthColor(piece));
+  const cached = depthColorCache.get(url);
+  if (cached) return cached;
+
+  const ImageConstructor = piece.ownerDocument.defaultView?.Image;
+  if (!ImageConstructor) return Promise.resolve(fallbackDepthColor(piece));
+
+  const result = new Promise<string>(resolve => {
+    const image = new ImageConstructor();
+    image.decoding = 'async';
+    image.crossOrigin = 'anonymous';
+    image.onload = () => {
+      try {
+        const naturalWidth = image.naturalWidth || 128;
+        const naturalHeight = image.naturalHeight || 128;
+        const scale = Math.min(1, 128 / Math.max(naturalWidth, naturalHeight));
+        const width = Math.max(1, Math.round(naturalWidth * scale));
+        const height = Math.max(1, Math.round(naturalHeight * scale));
+        const canvas = document.createElement('canvas');
+        canvas.width = width;
+        canvas.height = height;
+        const context = canvas.getContext('2d', { willReadFrequently: true });
+        if (!context) throw new Error('Canvas rendering context unavailable');
+        context.drawImage(image, 0, 0, width, height);
+        const pixels = context.getImageData(0, 0, width, height).data;
+        let red = 0;
+        let green = 0;
+        let blue = 0;
+        let weight = 0;
+
+        for (let index = 0; index < pixels.length; index += 4) {
+          const alpha = pixels[index + 3] / 255;
+          if (alpha === 0) continue;
+          red += pixels[index] * alpha;
+          green += pixels[index + 1] * alpha;
+          blue += pixels[index + 2] * alpha;
+          weight += alpha;
+        }
+
+        if (weight === 0) throw new Error('Piece asset contains no visible pixels');
+        const average = [red, green, blue].map(channel => Math.round(channel / weight));
+        resolve(`#${average.map(channel => channel.toString(16).padStart(2, '0')).join('')}`);
+      } catch (_) {
+        resolve(fallbackDepthColor(piece));
+      }
+    };
+    image.onerror = () => resolve(fallbackDepthColor(piece));
+    image.src = url;
+  });
+
+  depthColorCache.set(url, result);
+  return result;
+}
+
+function computedBackgroundImage(piece: HTMLElement): string {
+  const style = piece.ownerDocument.defaultView?.getComputedStyle(piece);
+  return style?.getPropertyValue('--xiangqi-piece-image').trim() || style?.backgroundImage || '';
+}
+
+function backgroundUrl(backgroundImage: string): string | undefined {
+  const match = backgroundImage.match(/^url\(["']?(.*?)["']?\)$/);
+  return match?.[1];
+}
+
+function fallbackDepthColor(piece: HTMLElement): string {
+  const pieceSet = document.body.dataset.pieceSet;
+  const red = piece.classList.contains('white');
+  if (pieceSet === 'xiangqi-wudang') return red ? '#99554c' : '#313a3a';
+  return '#8f5b3d';
+}
+
+type TravelStep = { progress: number; offset: number };
+const carrySteps: TravelStep[] = [
+  { progress: 0, offset: 0 },
+  { progress: 0, offset: 0.2 },
+  { progress: 0.32, offset: 0.4 },
+  { progress: 0.63, offset: 0.6 },
+  { progress: 0.93, offset: 0.8 },
+  { progress: 1, offset: 1 },
+];
+const slideSteps: TravelStep[] = [
+  { progress: 0, offset: 0 },
+  { progress: 0.35, offset: 0.23 },
+  { progress: 0.67, offset: 0.47 },
+  { progress: 0.94, offset: 0.75 },
+  { progress: 1, offset: 1 },
+];
+
+function animateTravel(
+  state: State,
+  runtime: MotionRuntime,
+  active: ActivePiece | undefined,
+  root: cg.PieceNode,
+  from: cg.NumberPair,
+  to: cg.NumberPair,
+  steps: TravelStep[],
+  duration: number,
+): Promise<void> {
+  const dx = to[0] - from[0],
+    dy = to[1] - from[1];
+  const travel = animate(
+    runtime,
+    active,
+    root,
+    steps.map(({ progress, offset }) => ({
+      transform: translated(from, dx, dy, progress),
+      offset,
+    })),
+    duration,
+  );
+  const connector = state.dom.elements.board.querySelector<SVGSVGElement>('.xiangqi-last-move-connector');
+  if (connector && root.cgKey === state.lastMove?.[1]) {
+    const bounds = state.dom.bounds();
+    const x = from[0] + bounds.width / 18;
+    const y = from[1] + bounds.height / 20;
+    const distance = Math.hypot(dx, dy);
+    // Reveal the existing dashes up to the travelling piece's center. The
+    // piece and reveal share every progress stop, duration and cancellation.
+    void animate(
+      runtime,
+      active,
+      connector,
+      steps.map(({ progress, offset }) => ({
+        clipPath: `circle(${distance * progress}px at ${x}px ${y}px)`,
+        offset,
+      })),
+      duration,
+    );
+  }
+  return travel;
+}
