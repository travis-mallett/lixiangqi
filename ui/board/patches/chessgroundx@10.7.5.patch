+import type { State } from './state.js';
+import type { AnimPlan } from './anim.js';
+/** The embedding board owns presentation. Chessground supplies lifecycle hooks only. */
+export interface PieceMotion {
+    sync(state: State): void;
+    shadows(state: State): void;
+    shadow(root: HTMLElement): void;
+    reset(state: State): void;
+    prepare(state: State): void;
+    animate(state: State, plan: AnimPlan, mode: 'move' | 'slide' | 'reveal'): void;
+}
+export declare function usesLayeredPieces(state: Pick<State, 'layeredPieces'>): boolean;
+export declare function syncXiangqiMotion(state: State): void;
+export declare function syncXiangqiShadows(state: State): void;
+export declare function syncXiangqiShadowPosition(state: State, root: HTMLElement): void;
+export declare function resetXiangqiMotion(state: State): void;
+export declare function prepareXiangqiMutation(state: State): void;
+export declare function animateXiangqi(state: State, plan: AnimPlan): void;
+export declare function animateXiangqiSlide(state: State, plan: AnimPlan): void;
+export declare function animateJieqiReveal(state: State, plan: AnimPlan): void;
