+export function usesLayeredPieces(state) { return state.layeredPieces; }
+export function syncXiangqiMotion(state) { state.pieceMotion?.sync(state); }
+export function syncXiangqiShadows(state) { state.pieceMotion?.shadows(state); }
+export function syncXiangqiShadowPosition(state, root) { state.pieceMotion?.shadow(root); }
+export function resetXiangqiMotion(state) { state.pieceMotion?.reset(state); }
+export function prepareXiangqiMutation(state) { state.pieceMotion?.prepare(state); }
+export function animateXiangqi(state, plan) { state.pieceMotion.animate(state, plan, 'move'); }
+export function animateXiangqiSlide(state, plan) { state.pieceMotion.animate(state, plan, 'slide'); }
+export function animateJieqiReveal(state, plan) { state.pieceMotion.animate(state, plan, 'reveal'); }
