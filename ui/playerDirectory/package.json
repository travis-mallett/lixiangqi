{
  "name": "playerDirectory",
  "private": true,
  "type": "module",
  "dependencies": {
    "bits": "workspace:*",
    "lib": "workspace:*"
  },
  "build": {
    "bundle": [
      "src/directoryPlayerFollow.ts",
      "src/directoryPlayerForm.ts"
    ]
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": {
        "source": "./src/*.ts",
        "default": "./dist/*.js"
      }
    }
  }
}
