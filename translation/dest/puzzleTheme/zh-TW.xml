<resources>
  <string name="advancedPawn">升變兵</string>
  <string name="advancedPawnDescription">你的其中一個兵已經深入了對方的棋位，或許要威脅升變。</string>
  <string name="advantage">取得優勢</string>
  <string name="advantageDescription">把握機會以取得決定性優勢。（200 厘兵 ≤ 評估值 ≤ 600 厘兵）</string>
  <string name="anastasiaMate">阿納斯塔西亞殺法</string>
  <string name="anastasiaMateDescription">馬與車或后聯手在棋盤邊困住對手國王以及另一對手棋子</string>
  <string name="arabianMate">阿拉伯殺法</string>
  <string name="arabianMateDescription">馬和車聯手把對方的王困住在角落的位置</string>
  <string name="attackingF2F7">攻擊 f2 或 f7</string>
  <string name="attackingF2F7Description">專注於 f2 或 f7 兵的攻擊，像是 fried liver 攻擊</string>
  <string name="attraction">吸引</string>
  <string name="attractionDescription">一種換子或犧牲強迫對手旗子到某格以好進行接下來的戰術。</string>
  <string name="backRankMate">後排將死</string>
  <string name="backRankMateDescription">在對方的王於底線被自身的棋子困住時，將死對方的王</string>
  <string name="bishopEndgame">主教殘局</string>
  <string name="bishopEndgameDescription">只剩象和兵的殘局</string>
  <string name="bodenMate">波登殺法</string>
  <string name="bodenMateDescription">以在對角線上的兩個主教將死被自身棋子困住的王。</string>
  <string name="castling">易位</string>
  <string name="castlingDescription">讓國王回到安全，並讓車發動攻擊。</string>
  <string name="capturingDefender">吃子 - 防守者</string>
  <string name="capturingDefenderDescription">移除防守其他棋子的防守者以攻擊未被保護的棋子</string>
  <string name="crushing">壓倒性優勢</string>
  <string name="crushingDescription">察覺對方的漏著並藉此取得巨大優勢。(大於600百分兵)</string>
  <string name="doubleBishopMate">雙主教將死</string>
  <string name="doubleBishopMateDescription">相鄰對角線上的兩個主教將將死被自身棋子困住的王。</string>
  <string name="dovetailMate">柯齊奧將死</string>
  <string name="dovetailMateDescription">以皇后將死被自身棋子困住的國王</string>
  <string name="equality">均勢</string>
  <string name="equalityDescription">從劣勢中反敗為和。（分析值 ≤ 200厘兵）</string>
  <string name="kingsideAttack">王翼攻擊</string>
  <string name="kingsideAttackDescription">在對方於王翼易位後的攻擊。</string>
  <string name="clearance">騰挪</string>
  <string name="clearanceDescription">為了施展戰術而清除我方攻擊格上的障礙物。</string>
  <string name="defensiveMove">加強防守</string>
  <string name="defensiveMoveDescription">一種為了避免遺失棋子或優勢而採取的必要行動。</string>
  <string name="deflection">引離</string>
  <string name="deflectionDescription">為了分散敵人專注力所採取的戰術，容易搗亂敵人原本的計畫。</string>
  <string name="discoveredAttack">閃擊</string>
  <string name="discoveredAttackDescription">將一子（例如騎士）移開長程攻擊格（例如城堡）。</string>
  <string name="doubleCheck">雙將</string>
  <string name="doubleCheckDescription">雙重將軍，讓我方能攻擊敵人的他子。</string>
  <string name="endgame">殘局</string>
  <string name="endgameDescription">棋局中最後階段的戰術</string>
  <string name="enPassantDescription">一種食敵方過路兵的戰略。</string>
  <string name="exposedKing">未被保護的國王</string>
  <string name="exposedKingDescription">攻擊未被保護的國王之戰術，常常導致將死。</string>
  <string name="fork">捉雙</string>
  <string name="forkDescription">一種同時攻擊敵方多個子，使敵方只能犧牲一子的戰術。</string>
  <string name="hangingPiece">懸子</string>
  <string name="hangingPieceDescription">「免費」取得他子的戰術</string>
  <string name="hookMate">鉤將死</string>
  <string name="hookMateDescription">利用車馬兵與一敵方兵以限制敵方國王的逃生路線。</string>
  <string name="interference">干擾</string>
  <string name="interferenceDescription">將一子擋在兩個敵方子之間以切斷防護，例如以騎士在兩車之間阻擋。</string>
  <string name="intermezzo">Intermezzo</string>
  <string name="intermezzoDescription">與其走正常的棋譜，不如威脅敵方子吧！這樣不但可以破壞敵方原先計畫，還可以讓敵人必須對威脅採取對應的動作。這種戰術又稱為「Zwischenzug」或「In between」。</string>
  <string name="killBoxMate">殺戮箱將死</string>
  <string name="killBoxMateDescription">一個城堡在敵方國王旁邊，由皇后支援，同時封鎖國王的逃脫路徑。城堡和皇后會將敵方國王困在 3×3 的『殺戮箱』中。</string>
  <string name="vukovicMate">武科維奇將死</string>
  <string name="vukovicMateDescription">一個城堡和一個騎士合作對國王發動將死。城堡執行將死攻擊，並由第三個棋子支援，而騎士則負責封鎖國王的逃脫路徑。</string>
