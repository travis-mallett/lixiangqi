+package lila.ws
+
+import ipc.ClientOut
+import play.api.libs.json.Json
+import lila.xiangqi.Xiangqi.Square
+
+class StudyProtocolTest extends munit.FunSuite:
+  private def move(orig: String, dest: String, path: String) = ClientOut
+    .parse(
+      Json.stringify(
+        Json.obj(
+          "t" -> "anaMove",
+          "d" -> Json.obj("orig" -> orig, "dest" -> dest, "path" -> path, "ch" -> "chapter1")
+        )
+      )
+    )
+    .get
+
+  test("study protocol accepts every native intersection and variable-length paths"):
+    Square.all.foreach: square =>
+      assert(move(square.key, "i10", "i1i2/i10i9").isInstanceOf[ClientOut.AnaMove])
+
+  test("malformed coordinates and historical encodings are rejected"):
+    List("a0", "i11", "j1", "a01", "a:", "A1").foreach: square =>
+      assert(move(square, "i10", "").isInstanceOf[ClientOut.Unexpected])
+    List("i1i2/", "abcd", "/i10i9", "i1i2//i10i9").foreach: path =>
+      assert(move("i10", "i9", path).isInstanceOf[ClientOut.Unexpected])
+
+  test("round and study moves use the same canonical coordinate parser"):
+    assert(ClientOut.parse("""{"t":"move","d":{"u":"i10i9"}}""").get.isInstanceOf[ClientOut.RoundMove])
+    assert(ClientOut.parse("""{"t":"move","d":{"u":"i010i9"}}""").get.isInstanceOf[ClientOut.Unexpected])
