diff --git a/src/main/scala/Presence.scala b/src/main/scala/Presence.scala
new file mode 100644
index 0000000..63f2738
--- /dev/null
+++ b/src/main/scala/Presence.scala
@@ -0,0 +1,102 @@
+package lila.ws
+
+import org.apache.pekko.actor.typed.ActorRef
+
+import ipc.ClientMsg
+
+/** Human visitor presence shared by every regular websocket endpoint. */
+final class Presence:
+
+  import Presence.*
+
+  private var connections = Map.empty[ActorRef[ClientMsg], Entry]
+  private var identities = Map.empty[String, Int]
+  private var activities = Map.empty[(String, String), Int]
+  private var categoryTotals = Map.empty[String, Int]
+
+  def connect(ref: ActorRef[ClientMsg], req: ClientActor.Req): Unit = synchronized:
+    disconnect(ref)
+    val entry = Entry(
+      identity(req),
+      categories(
+        req.header.queryParameter("activity").flatMap(Activity.apply),
+        req.header.queryParameter("activityGroup")
+      )
+    )
+    connections = connections.updated(ref, entry)
+    add(entry)
+
+  def disconnect(ref: ActorRef[ClientMsg]): Unit = synchronized:
+    connections.get(ref).foreach(remove)
+    connections = connections.removed(ref)
+
+  def update(ref: ActorRef[ClientMsg], activity: Option[String], group: Option[String] = None): Unit =
+    synchronized:
+      connections
+        .get(ref)
+        .foreach: entry =>
+          remove(entry)
+          val next = entry.copy(activities = categories(activity.flatMap(Activity.apply), group))
+          connections = connections.updated(ref, next)
+          add(next)
+
+  /** Counts each authenticated user/browser once per activity. */
+  def snapshot(rounds: Int): Snapshot = synchronized:
+    Snapshot(identities.size, rounds, categoryTotals)
+
+  private def add(entry: Entry): Unit =
+    identities = identities.updated(entry.identity, identities.getOrElse(entry.identity, 0) + 1)
+    entry.activities.foreach: activity =>
+      val key = entry.identity -> activity
+      val count = activities.getOrElse(key, 0)
+      activities = activities.updated(key, count + 1)
+      if count == 0 then
+        categoryTotals = categoryTotals.updated(activity, categoryTotals.getOrElse(activity, 0) + 1)
+
+  private def remove(entry: Entry): Unit =
+    val identityCount = identities(entry.identity) - 1
+    identities = if identityCount == 0 then identities.removed(entry.identity)
+    else identities.updated(entry.identity, identityCount)
+    entry.activities.foreach: activity =>
+      val key = entry.identity -> activity
+      val count = activities(key) - 1
+      activities = if count == 0 then activities.removed(key) else activities.updated(key, count)
+      if count == 0 then
+        val total = categoryTotals(activity) - 1
+        categoryTotals =
+          if total == 0 then categoryTotals.removed(activity) else categoryTotals.updated(activity, total)
+
+  private def identity(req: ClientActor.Req): String =
+    req.user match
+      case Some(u) => s"u:${u.value}"
+      case None =>
+        req.header
+          .queryParameter("visitor")
+          .flatMap(Visitor.apply)
+          .map(v => s"v:$v")
+          .getOrElse(s"s:${req.sri.value}")
+
+  private def categories(activity: Option[String], group: Option[String]): Set[String] =
+    activity.toSet ++ (if group.contains("other") && activity.exists(Activity.isLobbyOrPool) then Set("other")
+                       else Set.empty)
+
+  case class Entry(identity: String, activities: Set[String])
+
+object Presence:
+  case class Snapshot(members: Int, rounds: Int, activities: Map[String, Int])
+
+  object Visitor:
+    def apply(value: String): Option[String] =
+      Option.when(
+        value.length >= 8 && value.length <= 128 && value.forall(c =>
+          c.isLetterOrDigit || c == '-' || c == '_'
+        )
+      )(value)
+
+  object Activity:
+    private val pool = "[0-9]{1,3}\\+[0-9]{1,3}-m[0-9]{1,4}-[0-9]{1,4}x[0-9]{1,3}".r
+    def apply(value: String): Option[String] = value match
+      case "ai" | "friend" | "puzzle" | "lobby" => Some(value)
+      case pool() => Some(value)
+      case _ => None
+    def isLobbyOrPool(value: String): Boolean = value == "lobby" || pool.pattern.matcher(value).matches
diff --git a/src/test/scala/PresenceTest.scala b/src/test/scala/PresenceTest.scala
new file mode 100644
index 0000000..604ad8f
--- /dev/null
+++ b/src/test/scala/PresenceTest.scala
@@ -0,0 +1,82 @@
+package lila.ws
+
+import org.apache.pekko.actor.typed.{ ActorRef, ActorSystem }
+import org.apache.pekko.actor.typed.scaladsl.Behaviors
+
+class PresenceTest extends munit.FunSuite:
+
+  private val system = ActorSystem[Nothing](Behaviors.empty, "presence-test")
+  private val refs = collection.mutable.ListBuffer.empty[ActorRef[ipc.ClientMsg]]
+
+  override def afterAll() = system.terminate()
+
+  private def ref() =
+    val r = system.systemActorOf(Behaviors.empty[ipc.ClientMsg], s"presence-${refs.size}")
+    refs += r
+    r
+
+  private def req(sri: String, user: Option[String] = None, query: String = "") =
+    val uri = util.RequestUri(s"/?sri=$sri&$query")
+    val header =
+      util.RequestHeader(uri, IpAddress("127.0.0.1"), util.RequestHeader.Headers("", "", None, None))
+    ClientActor.Req(header, Sri(sri), user.map(u => Auth.Success.Cookie(User.Id(u))))
+
+  test("deduplicates tabs and categories per identity"):
+    val p = new Presence
+    val a = ref(); val b = ref()
+    p.connect(a, req("a1111111", None, "visitor=visitor-a&activity=puzzle"))
+    p.connect(b, req("b1111111", None, "visitor=visitor-a&activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(1, 0, Map("puzzle" -> 1)))
+    p.update(b, Some("lobby"))
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 1, "lobby" -> 1))
+    p.disconnect(a); assertEquals(p.snapshot(0).activities, Map("lobby" -> 1))
+    p.disconnect(b); assertEquals(p.snapshot(0), Presence.Snapshot(0, 0, Map.empty))
+
+  test("deduplicates authenticated accounts across browsers"):
+    val p = new Presence
+    val a = ref(); val b = ref()
+    p.connect(a, req("a2222222", Some("user"), "activity=puzzle"))
+    p.connect(b, req("b2222222", Some("user"), "activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(1, 0, Map("puzzle" -> 1)))
+    p.disconnect(a); assertEquals(p.snapshot(0).activities, Map("puzzle" -> 1))
+
+  test("counts distinct visitors and protects reconnects"):
+    val p = new Presence
+    val a = ref(); val b = ref(); val old = ref(); val fresh = ref(); val unknown = ref()
+    p.connect(a, req("a3333333", None, "visitor=visitor-a&activity=puzzle"))
+    p.connect(b, req("b3333333", None, "visitor=visitor-b&activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(2, 0, Map("puzzle" -> 2)))
+    p.connect(old, req("same-sri", None, "activity=puzzle"))
+    p.connect(fresh, req("same-sri", None, "activity=puzzle"))
+    p.disconnect(old)
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 3))
+    p.update(unknown, Some("puzzle"))
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 3))
+
+  test("validates activities and pool ids"):
+    assert(Presence.Activity("15+0-m90-30x3").isDefined)
+    assert(Presence.Activity("puzzle").isDefined)
+    assert(Presence.Activity("pool:15+0").isEmpty)
+    assert(Presence.Activity("unknown").isEmpty)
+
+  test("accepts Xiangqi ten-rank UCI"):
+    assert(XiangqiUci.from("a9a10").isDefined)
+
+  test("groups quick pools into one other count"):
