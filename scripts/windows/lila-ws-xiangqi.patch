@@ -0,0 +1,43 @@
+package lila.ws
+
+import com.typesafe.config.ConfigFactory
+import lila.ws.util.{ RequestHeader, RequestUri }
+
+class MobilePlayAuthTest extends munit.FunSuite:
+  private given Executor = scala.concurrent.ExecutionContext.global
+  private val auth = new Auth(null, null, ConfigFactory.load())
+
+  private def request(path: String, bearer: String) = new RequestHeader(
+    RequestUri(path),
+    IpAddress("127.0.0.1"),
+    RequestHeader.Headers("", "LiXiangQi-Mobile/0.1", None, Some(s"Bearer $bearer"))
+  )
+
+  test("raw native bearer grants only the lobby play scope"):
+    val parsed = auth.bearerFromHeader(request("/lobby/socket/v5?sri=abcdefghijklmnop", "test-token"))
+    assertEquals(parsed.map(_._2), Some(List("mobile:play")))
+
+  test("raw native bearer cannot authenticate unrelated websocket surfaces"):
+    List("/socket/v5", "/challenge/12345678/socket/v5", "/watch/12345678/white/v6").foreach: path =>
+      assertEquals(auth.bearerFromHeader(request(path, "test-token")), None)
+
+  test("native tournament tokens are restricted to tournament rooms"):
+    val parsed = auth.bearerFromHeader(request("/tournament/abcd1234/socket/v5?sri=abcdefghijklmnop", "test-token"))
+    assertEquals(parsed.map(_._2), Some(List("tournament:write")))
+    assertEquals(auth.bearerFromHeader(request("/tournament/bad/socket/v5", "test-token")), None)
+    assertEquals(auth.bearerFromHeader(request("/tournament/abcd1234/socket/v5", "test-token:bad")), None)
+
+  test("invalid signatures never fall back to native authentication"):
+    assertEquals(auth.bearerFromHeader(request("/lobby/socket/v5", "test-token:bad-signature")), None)
+
+  test("native puzzle and play scopes authenticate only the presence endpoint"):
+    val parsed = auth.bearerFromHeader(request("/mobile/presence?sri=abcdefghijklmnop", "test-token"))
+    assertEquals(parsed.map(_._2), Some(List("mobile:play", "puzzle:read", "puzzle:write")))
+
+  test("presence endpoint only accepts heartbeat and presence messages"):
+    import ipc.ClientOut
+    assert(SiteClientActor.allows("/mobile/presence", ClientOut.Ping(None)))
+    assert(SiteClientActor.allows("/mobile/presence", ClientOut.Presence(Some("puzzle"))))
+    assert(!SiteClientActor.allows("/mobile/presence", ClientOut.FollowingOnline(true)))
+    assert(!SiteClientActor.allows("/mobile/presence", ClientOut.Notified))
+    assert(SiteClientActor.allows("/socket/v5", ClientOut.FollowingOnline(true)))
