diff --git a/src/test/scala/ExtraRoundsTest.scala b/src/test/scala/ExtraRoundsTest.scala
new file mode 100644
--- /dev/null
+++ b/src/test/scala/ExtraRoundsTest.scala
@@ -0,0 +1,25 @@
+package lila.ws
+
+class ExtraRoundsTest extends munit.FunSuite:
+  test("snapshots replace counts and expire if the publisher stops"):
+    var time = 0L
+    val count = new Lobby.ExtraRounds(() => time)
+    assertEquals(count.get, 0)
+    count.update(3)
+    assertEquals(count.get, 3)
+    time += 15.seconds.toNanos
+    count.update(2)
+    assertEquals(count.get, 2)
+    time += 44.seconds.toNanos
+    assertEquals(count.get, 2)
+    time += 1.second.toNanos
+    assertEquals(count.get, 0)
+    count.update(1)
+    assertEquals(count.get, 1)
+    count.update(0)
+    assertEquals(count.get, 0)
+
+  test("round count protocol rejects invalid values"):
+    assertEquals(ipc.LilaOut.read("lobby/extra-rounds 3"), Some(ipc.LilaOut.ExtraRounds(3)))
+    assertEquals(ipc.LilaOut.read("lobby/extra-rounds -1"), None)
+    assertEquals(ipc.LilaOut.read("lobby/extra-rounds invalid"), None)
