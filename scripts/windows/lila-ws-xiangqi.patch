+package lila.ws
+
+import org.apache.pekko.actor.typed.{ ActorRef, ActorSystem }
+import org.apache.pekko.actor.typed.scaladsl.Behaviors
+
+class PresenceTest extends munit.FunSuite:
+
+  private val system = ActorSystem[Nothing](Behaviors.empty, "presence-test")
+  private val refs = collection.mutable.ListBuffer.empty[ActorRef[ipc.ClientMsg]]
+
+  override def afterAll() = system.terminate()
+
+  private def ref() =
+    val r = system.systemActorOf(Behaviors.empty[ipc.ClientMsg], s"presence-${refs.size}")
+    refs += r
+    r
+
+  private def req(sri: String, user: Option[String] = None, query: String = "") =
+    val uri = util.RequestUri(s"/?sri=$sri&$query")
+    val header =
+      util.RequestHeader(uri, IpAddress("127.0.0.1"), util.RequestHeader.Headers("", "", None, None))
+    ClientActor.Req(header, Sri(sri), user.map(u => Auth.Success.Cookie(User.Id(u))))
+
+  test("deduplicates tabs and categories per identity"):
+    val p = new Presence
+    val a = ref(); val b = ref()
+    p.connect(a, req("a1111111", None, "visitor=visitor-a&activity=puzzle"))
+    p.connect(b, req("b1111111", None, "visitor=visitor-a&activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(1, 0, Map("puzzle" -> 1)))
+    p.update(b, Some("lobby"))
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 1, "lobby" -> 1))
+    p.disconnect(a); assertEquals(p.snapshot(0).activities, Map("lobby" -> 1))
+    p.disconnect(b); assertEquals(p.snapshot(0), Presence.Snapshot(0, 0, Map.empty))
+
+  test("deduplicates authenticated accounts across browsers"):
+    val p = new Presence
+    val a = ref(); val b = ref()
+    p.connect(a, req("a2222222", Some("user"), "activity=puzzle"))
+    p.connect(b, req("b2222222", Some("user"), "activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(1, 0, Map("puzzle" -> 1)))
+    p.disconnect(a); assertEquals(p.snapshot(0).activities, Map("puzzle" -> 1))
+
+  test("counts distinct visitors and protects reconnects"):
+    val p = new Presence
+    val a = ref(); val b = ref(); val old = ref(); val fresh = ref(); val unknown = ref()
+    p.connect(a, req("a3333333", None, "visitor=visitor-a&activity=puzzle"))
+    p.connect(b, req("b3333333", None, "visitor=visitor-b&activity=puzzle"))
+    assertEquals(p.snapshot(0), Presence.Snapshot(2, 0, Map("puzzle" -> 2)))
+    p.connect(old, req("same-sri", None, "activity=puzzle"))
+    p.connect(fresh, req("same-sri", None, "activity=puzzle"))
+    p.disconnect(old)
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 3))
+    p.update(unknown, Some("puzzle"))
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 3))
+
+  test("validates activities and pool ids"):
+    assert(Presence.Activity("15+0-m90-30x3").isDefined)
+    assert(Presence.Activity("puzzle").isDefined)
+    assert(Presence.Activity("pool:15+0").isEmpty)
+    assert(Presence.Activity("unknown").isEmpty)
+
+  test("groups quick pools into one other count"):
+    val p = new Presence
+    val a = ref(); val b = ref(); val c = ref()
+    p.connect(a, req("a4444444", None, "visitor=visitor-a"))
+    p.connect(b, req("b4444444", None, "visitor=visitor-a"))
+    p.update(a, Some("5+0-m60-30x3"), Some("other"))
+    p.update(b, Some("10+0-m60-30x3"), Some("other"))
+    assertEquals(
+      p.snapshot(0),
+      Presence.Snapshot(1, 0, Map("5+0-m60-30x3" -> 1, "10+0-m60-30x3" -> 1, "other" -> 1))
+    )
+    p.connect(c, req("c4444444", None, "visitor=visitor-b"))
+    p.update(c, Some("5+0-m60-30x3"), Some("other"))
+    assertEquals(p.snapshot(0).activities("other"), 2)
+    p.disconnect(a); assertEquals(p.snapshot(0).activities("other"), 2)
+    p.update(b, None, None); assertEquals(p.snapshot(0).activities("other"), 1)
+    p.update(c, Some("puzzle"), Some("other"));
+    assertEquals(p.snapshot(0).activities.getOrElse("other", 0), 0)
+
+  test("native and web sessions deduplicate by account, including category changes"):
+    val p = new Presence
+    val web = ref(); val mobile = ref(); val kids = ref()
+    p.connect(web, req("web12345", Some("alice"), "activity=puzzle"))
+    val native = req("mobile12", None, "activity=puzzle").copy(
+      auth = Some(Auth.Success.OAuth(User.Id("alice"), "mobile:play,puzzle:write"))
+    )
+    p.connect(mobile, native)
+    p.connect(kids, native.copy(sri = Sri("kids1234")))
+    assertEquals(p.snapshot(0), Presence.Snapshot(1, 0, Map("puzzle" -> 1)))
+    p.update(mobile, Some("15+0-m90-30x3"))
+    assertEquals(p.snapshot(0).activities, Map("puzzle" -> 1, "15+0-m90-30x3" -> 1))
+    p.disconnect(web)
+    p.disconnect(kids)
+    assertEquals(p.snapshot(0).activities, Map("15+0-m90-30x3" -> 1))
+    p.disconnect(mobile)
+    assertEquals(p.snapshot(0), Presence.Snapshot(0, 0, Map.empty))
+
+  test("Jieqi union deduplicates players across modes and removes departed sessions"):
+    val p = new Presence
+    val rated = ref(); val ai = ref(); val friend = ref()
+    p.connect(rated, req("rated123", Some("alice")))
+    p.connect(ai, req("ai123456", Some("alice")))
+    p.connect(friend, req("friend12", Some("bob")))
+    val pool = "jieqi-v1-ranked-10+0-m60-30x3"
+    p.update(rated, Some(pool), Some("other"))
+    p.update(ai, Some("jieqi-ai"))
+    p.update(friend, Some("jieqi-friend"))
+    assertEquals(p.snapshot(0).activities, Map(pool -> 1, "jieqi-ai" -> 1, "jieqi-friend" -> 1, "jieqi" -> 2))
+    p.disconnect(rated)
+    assertEquals(p.snapshot(0).activities("jieqi"), 2)
+    p.update(ai, None)
+    assertEquals(p.snapshot(0).activities, Map("jieqi-friend" -> 1, "jieqi" -> 1))
+    p.disconnect(friend)
+    assertEquals(p.snapshot(0).activities, Map.empty[String, Int])
+    assert(Presence.Activity("jieqi-v1-ranked-invalid").isEmpty)
+    assert(Presence.Activity("jieqi").isEmpty)
+
+  test("Mini Xiangqi populations remain independent of Jieqi and standard rooms"):
+    val p = new Presence
+    val mini = ref(); val jieqi = ref(); val friend = ref()
+    p.connect(mini, req("mini1234", Some("alice")))
+    p.connect(jieqi, req("jieqi123", Some("alice")))
+    p.connect(friend, req("friend12", Some("bob")))
+    val pool = "minixiangqi-v1-ranked-10+0-m60-30x3"
+    p.update(mini, Some(pool), Some("other"))
+    p.update(jieqi, Some("jieqi-ai"))
+    p.update(friend, Some("minixiangqi-friend"))
+    assertEquals(p.snapshot(0).activities, Map(pool -> 1, "minixiangqi-friend" -> 1, "minixiangqi" -> 2, "jieqi-ai" -> 1, "jieqi" -> 1))
+    p.disconnect(mini)
+    assertEquals(p.snapshot(0).activities("minixiangqi"), 1)
+    p.disconnect(friend)
+    assert(!p.snapshot(0).activities.contains("minixiangqi"))
+    assert(Presence.Activity("minixiangqi-v1-ranked-invalid").isEmpty)
+    assert(Presence.Activity("minixiangqi").isEmpty)
