--- a/src/main/scala/model.scala
+++ b/src/main/scala/model.scala
@@ -114,6 +114,23 @@ object ChapterId extends OpaqueString[ChapterId]
 opaque type JsonString = String
 object JsonString extends OpaqueString[JsonString]
 
+opaque type XiangqiUci = String
+object XiangqiUci:
+  def from(value: String): Option[XiangqiUci] =
+    (2 until value.length)
+      .find(offset => isFile(value(offset)))
+      .filter(offset => isSquare(value.take(offset)) && isSquare(value.drop(offset)))
+      .map(_ => value)
+
+  private def isFile(char: Char) = char >= 'a' && char <= 'i'
+
+  private def isSquare(value: String) =
+    value.length >= 2 &&
+      isFile(value.head) &&
+      value.tail.toIntOption.exists(rank => rank >= 1 && rank <= 10)
+
+  extension (uci: XiangqiUci) def value: String = uci
+
 opaque type SocketVersion = Int
 object SocketVersion extends OpaqueInt[SocketVersion]
 
