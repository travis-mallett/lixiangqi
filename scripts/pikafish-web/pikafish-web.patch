     // network related
 
+    bool load_network(std::istream& input) {
+        bool loaded = true;
+        network.modify_and_replicate([&](auto& replica) {
+            input.clear();
+            input.seekg(0);
+            auto description = replica.load(input);
+            loaded = loaded && description.has_value();
+            if (description) {
+                networkFile.current = networkFile.defaultName;
+                networkFile.netDescription = *description;
+            }
+        });
+        if (!loaded) return false;
+        threads.clear();
+        threads.ensure_network_replicated();
+        return true;
+    }
