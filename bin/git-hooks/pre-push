#!/bin/sh

set -eu

remote_name=${1:-}
remote_url=${2:-}
zero_oid=0000000000000000000000000000000000000000
lishogi_tip=acb3b12286dd41bc88edfa81172e6a5e7f68c52b

case "$remote_url" in
  https://github.com/travis-mallett/lixiangqi.git | git@github.com:travis-mallett/lixiangqi.git) ;;
  *)
    printf >&2 'Push blocked: expected the official Lixiangqi repository, got %s (%s).\n' "$remote_url" "$remote_name"
    exit 1
    ;;
esac

if [ "${LIXIANGQI_ALLOW_PUSH:-}" != 1 ]; then
  printf >&2 '%s\n' \
    'Push intentionally locked.' \
    'After reviewing the final pre-push report, explicitly set LIXIANGQI_ALLOW_PUSH=1 for the approved push.'
  exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  printf >&2 'Push blocked: tracked working-tree or index changes remain.\n'
  exit 1
fi

updates_file=$(mktemp "${TMPDIR:-/tmp}/lixiangqi-pre-push.XXXXXX")
trap 'rm -f "$updates_file"' EXIT HUP INT TERM
cat >"$updates_file"

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue

  if [ "$local_oid" = "$zero_oid" ]; then
    printf >&2 'Push blocked: ref deletion is not allowed by the release-safety hook.\n'
    exit 1
  fi

  if [ "$local_ref" != refs/heads/master ] || [ "$remote_ref" != refs/heads/master ]; then
    printf >&2 'Push blocked: only refs/heads/master -> refs/heads/master is permitted.\n'
    exit 1
  fi

  if git merge-base --is-ancestor "$lishogi_tip" "$local_oid"; then
    printf >&2 'Push blocked: the historical lishogi branch is reachable from the proposed tip.\n'
    exit 1
  fi

  if [ "$remote_oid" != "$zero_oid" ] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
    printf >&2 'Push blocked: the update is not a fast-forward of the remote branch.\n'
    exit 1
  fi
done <"$updates_file"

git fsck --no-dangling
git lfs fsck
git lfs pre-push "$@" <"$updates_file"
